<%- include("partials/header") %>

<h1>New message</h1>

<% if (errors.length > 0) { %>
  <div class="errors" role="alert">
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/messages" method="POST">
  <label for="title">Title</label>
  <input id="title" name="title" type="text" required maxlength="100" value="<%= values.title %>">

  <label for="body">Message</label>
  <textarea id="body" name="body" rows="5" required maxlength="1000"><%= values.body %></textarea>

  <button type="submit">Post</button>
</form>

<p><a href="/">Cancel</a></p>

<%- include("partials/footer") %>